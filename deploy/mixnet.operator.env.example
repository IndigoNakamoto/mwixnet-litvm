# Operator-local env for Proof A (copy to deploy/mixnet.operator.env and chmod 600).
# Never commit the real file. Do not paste secrets into chat.

# Mac wallet unlock (ltc-wallet-mac wallet-cli). Required to list coins / export scan-spend.
WALLET_PASSPHRASE=

# Written by: cargo run -p wallet-cli -- --data-dir "$HOME/Library/Application Support/com.indigonakamoto.ltc-wallet" mweb-coinswapd-env --out deploy/mixnet.operator.env
# (merge by hand if this file already has WALLET_PASSPHRASE; the CLI overwrites the three keys below.)
MWEB_SCAN_SECRET=
MWEB_SPEND_SECRET=
E2E_MWEB_DEST=

# Mixnode X25519 private keys (32-byte hex). Public hex goes in mixnet.directory.json.
MIX_K0=
MIX_K1=
MIX_K2=
