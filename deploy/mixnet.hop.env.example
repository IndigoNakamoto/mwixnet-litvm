# One mixnode hop (copy to deploy/mixnet.hop.env and chmod 600). Never commit the real file.
# No scan/spend keys — hop 0 accepts swap_swap of a prebuilt onion; hops 1–2 only peel/forward.

MIX_K=
E2E_MWEB_DEST=
MLN_HOP_INDEX=0
LISTEN_PORT=8334
MIXNET_DIRECTORY=
# Optional Neutrino working directory (default: data/mixnode-hop$MLN_HOP_INDEX under repo root)
# MIXNODE_DATADIR=
